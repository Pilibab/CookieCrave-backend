# ==============================================================================
# FRONTEND (Client-Side)
# Variables starting with NEXT_PUBLIC_ are bundled into browser JavaScript.
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

NEXT_PUBLIC_API_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_FRONTEND_URL=http://localhost:3000

# ==============================================================================
# BACKEND / SERVER-ONLY (Keep Secret!)
# These must NEVER be exposed to the browser.
# ==============================================================================
# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-admin-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Database Connections (Prisma / ORM / Direct SQL)
# Transaction Pooler (Port 6543) -> Used for runtime app queries
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Connection (Port 5432) -> Used for migrations & schema updates
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres